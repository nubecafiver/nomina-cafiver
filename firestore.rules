rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== Lista blanca de correos que pueden ver/editar la NÓMINA ======
    // Edita esta función con los correos autorizados (director y operadores).
    function nominaAutorizado() {
      return request.auth != null && request.auth.token.email in [
        "director@cafiver.com.mx",
        "operador@cafiver.com.mx"
      ];
    }

    // La colección de nómina: SOLO los correos de la lista blanca.
    // Así, aunque el proyecto sea compartido con Gantt/Inventario,
    // los datos sensibles de nómina quedan aislados.
    match /nominaRows/{doc} {
      allow read, write: if nominaAutorizado();
    }

    // El resto de colecciones (Gantt, inventario, etc.): cualquier
    // usuario autenticado, como ya lo tenías.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
